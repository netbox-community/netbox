{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    // Some of GraphiQL's dependencies ship declarations that fail to type-check, e.g. by importing
    // optional packages that aren't installed (graphql-ws, graphql-config). tsconfig.libcheck.json
    // checks all other declaration files, including those in src/.
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
