{
  "name": "netbox",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:styles": "node build.mjs --styles",
    "build:scripts": "node build.mjs --scripts",
    "check": "npm run check:types && npm run check:lint && npm run check:format",
    "check:types": "tsc && tsc -p tsconfig.libcheck.json",
    "check:lint": "eslint src \"*.mjs\" eslint.config.js",
    "check:format": "prettier --check \"src/**/*.ts\" \"styles/**/*.scss\" \"*.mjs\" eslint.config.js",
    "format": "prettier --write \"src/**/*.ts\" \"styles/**/*.scss\" \"*.mjs\" eslint.config.js",
    "upgrade": "node upgrade.mjs"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@graphiql/plugin-explorer": "5.1.5",
    "@graphiql/toolkit": "0.12.1",
    "@mdi/font": "7.4.47",
    "@popperjs/core": "2.11.8",
    "@tabler/core": "1.7.0",
    "bootstrap": "5.3.8",
    "flatpickr": "4.6.13",
    "graphiql": "5.4.0",
    "graphql": "17.0.2",
    "gridstack": "14.0.0",
    "htmx.org": "2.0.10",
    "inter-ui": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tom-select": "2.6.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bootstrap": "5.2.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "esbuild-sass-plugin": "3.7.0",
    "eslint": "10.10.0",
    "postcss": "8.5.30",
    "postcss-prefix-custom-properties": "0.1.0",
    "prettier": "3.9.6",
    "sass": "1.104.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
