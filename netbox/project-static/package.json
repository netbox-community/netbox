{
  "name": "netbox",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.15",
    "npm": ">=11.10"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:styles": "node build.mjs --styles",
    "build:scripts": "node build.mjs --scripts",
    "check": "npm run check:types && npm run check:lint && npm run check:format",
    "check:types": "tsc",
    "check:lint": "eslint src \"*.mjs\" eslint.config.js",
    "check:format": "prettier --check \"src/**/*.ts\" \"styles/**/*.scss\" \"*.mjs\" eslint.config.js",
    "format": "prettier --write \"src/**/*.ts\" \"styles/**/*.scss\" \"*.mjs\" eslint.config.js",
    "upgrade": "node upgrade.mjs"
  },
  "dependencies": {
    "@graphiql/plugin-explorer": "4.0.6",
    "@mdi/font": "7.4.47",
    "@popperjs/core": "2.11.8",
    "@tabler/core": "1.4.0",
    "bootstrap": "5.3.8",
    "clipboard": "2.0.11",
    "flatpickr": "4.6.13",
    "graphiql": "4.1.2",
    "graphql": "16.12.0",
    "gridstack": "14.0.0",
    "htmx.org": "2.0.10",
    "js-cookie": "3.0.8",
    "query-string": "9.5.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tom-select": "2.6.2",
    "typeface-inter": "3.18.1",
    "typeface-roboto-mono": "1.1.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bootstrap": "5.2.11",
    "esbuild": "0.28.2",
    "esbuild-sass-plugin": "3.7.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "sass": "1.104.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
